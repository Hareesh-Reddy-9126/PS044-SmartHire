# Build output (images compile from source in their build stages)
**/target/

# Git & docs (not needed in image build context)
.git
.gitignore
docs

# Bundled agent tooling
.claude
.agents
skills-lock.json

# IDE
.idea
.vscode
*.iml

# Node (frontend added at Inc 5)
node_modules
frontend/node_modules
frontend/dist

# Secrets / env (never copy into an image, including nested env files)
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs / OS
*.log
.DS_Store
Thumbs.db
