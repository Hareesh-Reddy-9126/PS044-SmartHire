# Build output (exclude for all modules except the ones we build images for)
**/target/
!services/application-service/target/
!services/recruitment-service/target/
!services/job-service/target/
!services/auth-service/target/
!services/api-gateway/target/
!services/service-registry/target/

# Git & docs (not needed in image build context)
.git
.gitignore
docs

# Bundled agent tooling
.claude
.agents
skills-lock.json

# IDE
.idea
.vscode
*.iml

# Node (frontend added at Inc 5)
node_modules

# Secrets / env (never copy into an image)
.env
.env.*
!.env.example

# Logs / OS
*.log
.DS_Store
Thumbs.db

