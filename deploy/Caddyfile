# SmartHire production reverse proxy.
# Static React build and API gateway traffic are served from the same origin.
# DOMAIN and ACME_EMAIL are injected by compose from deploy/.env.

{
  email {$ACME_EMAIL}
  admin off
}

{$DOMAIN} {
  encode zstd gzip
  # Hardened response headers for the browser SPA.
  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; font-src 'self' data:; img-src 'self' data: https://*.googleusercontent.com; connect-src 'self' https://accounts.google.com; frame-src https://accounts.google.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  }

  @backend {
    path /api/*
    path /oauth2/*
    path /actuator/*
  }
  handle @backend {
    reverse_proxy api-gateway:8080
  }

  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }

  log {
    output stderr
    format json
  }
}
