# SmartHire Inc 0 + Inc 1 — environment template.
# Copy to deploy/.env and fill in real values:  cp deploy/.env.example deploy/.env
# deploy/.env is git-ignored and must NEVER be committed (governance §17 — no secrets in git).
# This template lists KEYS ONLY. Do not put real secret values here.

# --- PostgreSQL (shared instance; job-service and auth-service each own a schema via Flyway) ---
# Database name (non-secret; defaults to "smarthire" in compose if omitted).
POSTGRES_DB=
# Application DB user (Inc 0/1 use this single user for job-service and auth-service).
POSTGRES_USER=
# DB password — SECRET. Leave blank here; set the real value only in deploy/.env.
POSTGRES_PASSWORD=

# --- API gateway ---
# Allowed CORS origin (the future React SPA dev server; non-secret).
GATEWAY_CORS_ALLOWED_ORIGINS=

# --- Auth service (Inc 1) ---
# RS256 signing key, PKCS#8 PEM — SECRET. Leave blank to generate an ephemeral dev keypair at
# startup (tokens do not survive a restart; the gateway still verifies against the live JWKS).
AUTH_JWT_PRIVATE_KEY=
# Development seeding of the non-self-service roles (decision 7). Runs only under the "seed" profile
# (compose sets it) AND when BOTH the email and password of an account are supplied here. Leave any
# of these blank to skip that account. Passwords are SECRET — set real values only in deploy/.env,
# never here (decision 8: no known/reusable demo password in git).
AUTH_SEED_RECRUITER_EMAIL=
AUTH_SEED_RECRUITER_PASSWORD=
AUTH_SEED_ADMIN_EMAIL=
AUTH_SEED_ADMIN_PASSWORD=
