# SmartHire production environment template.
#
# Copy to deploy/.env and fill real values:
#   cp deploy/.env.production.example deploy/.env
#
# deploy/.env is git-ignored. NEVER commit real secret values, and never expose secrets to logs.
# Leave keys blank here; set real values only in the actual environment file.

# ---- Public deployment ----
# Public hostname used by Caddy's automatic TLS and the SPA's same-origin URLs (no scheme).
DOMAIN=
# ACME account email for Let's Encrypt notifications.
ACME_EMAIL=
# Extra CORS origin if the SPA is hosted on a separate origin later. Optional because production
# serves the SPA from the same origin.
GATEWAY_CORS_ALLOWED_ORIGINS=

# ---- PostgreSQL (shared instance; each service owns a schema via Flyway) ----
POSTGRES_DB=
POSTGRES_USER=
# DB password — SECRET.
POSTGRES_PASSWORD=

# ---- Auth service ----
# PKCS#8 PEM signing key — SECRET. Rotate before production and again after any compromise.
AUTH_JWT_PRIVATE_KEY=
# Stable issuer/audience expected by all service JWT decoders.
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=
# Invitation code for administrator self-registration — SECRET. Leave blank to disable admin
# signup. Candidates and recruiters register without a code.
AUTH_ADMIN_SIGNUP_CODE=

# ---- Notification / email ----
# `resend` delivers over the Resend HTTPS API (free tier, no mailbox needed) and requires
# RESEND_API_KEY + RESEND_FROM. `smtp` sends real email and requires HOST + FROM. `logging`
# records notifications without sending mail; use it only when no provider is available.
NOTIFICATION_SENDER_TYPE=resend
NOTIFICATION_RESEND_API_KEY=
# Sender identity, e.g. "SmartHire <onboarding@resend.dev>" for the shared sandbox address.
NOTIFICATION_RESEND_FROM=
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=
NOTIFICATION_SMTP_USERNAME=
# SMTP password — SECRET. Leave blank if your SMTP relay uses IP allowlisting.
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_FROM=
NOTIFICATION_DELIVERY_MAX_ATTEMPTS=
NOTIFICATION_DELIVERY_RETRY_BACKOFF_MS=

# ---- AI service ----
AI_ENABLED=
# `mock` is the only provider implemented in this build. `claude` fails fast until implemented.
AI_PROVIDER=
# Anthropic API key — SECRET. Required only when a real provider is implemented.
AI_CLAUDE_API_KEY=
AI_CLAUDE_MODEL=

# ---- Backups ----
# Backup path on the VM host (may be a mounted disk or bind mount, not inside the container).
BACKUP_DIR=
# Days of local backup retention. Remote/off-VM retention is documented in docs/deployment.
BACKUP_RETENTION_DAYS=
# Volume name for document uploads, if you want backups to include them.
DOCUMENTS_VOLUME=
