<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.smarthire</groupId>
    <artifactId>smarthire-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>smarthire-common</artifactId>
  <name>SmartHire :: Common</name>
  <description>Shared cross-cutting library: correlation-id propagation + RFC 9457 Problem Details base.</description>

  <dependencies>
    <!-- Servlet web primitives: OncePerRequestFilter, ProblemDetail, @RestControllerAdvice. -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <!-- @AutoConfiguration + @ConditionalOnWebApplication so this activates only in servlet services. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>
    <!-- FilterRegistrationBean lives here (org.springframework.boot.web.servlet). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot</artifactId>
    </dependency>
    <!-- Logging facade used directly (SLF4J + MDC, governance §61). Not pulled by the minimal
         deps above, so it is declared explicitly; version managed by the Spring Boot BOM. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Servlet API is compile-time only; the host service provides the container at runtime. -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
